#!/usr/bin/env python3
"""tui-shot — run heron in a pty, feed keys, capture the rendered screen.

Usage:
  bin/tui-shot [--seed FILE] [--demo] [--keys "text\r"] [--out FILE]
               [--cols N] [--rows N] [--settle S] [--raw]

It boots the real binary in a pseudo-terminal (so bubbletea goes into raw
mode and paints for real), types the key sequence, then writes the
ANSI-stripped final screen to --out (default: stdout). This is the manual
visual check complement to the model-level tests in internal/tui.
"""
import argparse, fcntl, os, pty, re, select, struct, subprocess, sys, termios, time

KEYMAP = {
    "\\r": b"\r", "\r": b"\r", "\n": b"\n", "\t": b"\t",
    "^C": b"\x03", "esc": b"\x1b", "up": b"\x1b[A", "down": b"\x1b[B",
    "tab": b"\t",
}

ESC = re.compile(r"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)"
                 r"|\x1b\[[0-9;:?]*[ -/]*[@-~]"
                 r"|\x1b[@-Z\\-_]")

def emit(keys):
    """Translate a key script into a byte stream, expanding named keys."""
    out = bytearray()
    i = 0
    names = sorted(KEYMAP, key=len, reverse=True)
    while i < len(keys):
        hit = None
        for n in names:
            if keys.startswith(n, i):
                hit = n
                break
        if hit:
            out += KEYMAP[hit]
            i += len(hit)
        else:
            out += keys[i].encode()
            i += 1
    return bytes(out)

# Capability queries a TUI sends on startup. A bare pty never answers them,
# so the app would block on its first frame — we play the terminal here.
REPLIES = [
    (b"\x1b]11;?", b"\x1b]11;rgb:0000/0000/0000\x1b\\"),
    (b"\x1b]10;?", b"\x1b]10;rgb:ffff/ffff/ffff\x1b\\"),
    (b"\x1b[6n",   b"\x1b[1;1R"),
    (b"\x1b[>q",   b"\x1bP>|heron-shot/xterm-256color\x1b\\"),
    (b"\x1b[?u",   b"\x1b[?0u"),
    (b"\x1b[c",    b"\x1b[?1;2c"),
]

def respond(fd, data):
    for query, answer in REPLIES:
        if query in data:
            try:
                os.write(fd, answer)
            except OSError:
                pass

def drain(fd, seconds, buf):
    end = time.time() + seconds
    while time.time() < end:
        r, _, _ = select.select([fd], [], [], 0.05)
        if not r:
            continue
        try:
            data = os.read(fd, 65536)
        except OSError:
            break
        if not data:
            break
        buf.append(data)
        respond(fd, data)
    return buf

class Screen:
    """Minimal terminal emulator — enough for what bubbletea emits."""

    def __init__(self, rows, cols):
        self.rows, self.cols = rows, cols
        self.g = [[" "] * cols for _ in range(rows)]
        self.r = self.c = 0
        self.pending = False   # deferred autowrap, as in a real terminal

    def clear(self):
        for y in range(self.rows):
            for x in range(self.cols):
                self.g[y][x] = " "

    def put(self, ch):
        if self.pending:
            # Deferred wrap: a real terminal stays on the last cell until the
            # next character arrives. Wrapping eagerly shifts every following
            # line, because bubbletea tracks its own cursor position.
            self.pending = False
            self.c = 0
            self.r = min(self.r + 1, self.rows - 1)
        if 0 <= self.r < self.rows and 0 <= self.c < self.cols:
            self.g[self.r][self.c] = ch
        if self.c >= self.cols - 1:
            self.c = self.cols - 1
            self.pending = True
        else:
            self.c += 1

    def erase(self, start, end):
        for x in range(max(0, start), min(self.cols, end)):
            self.g[self.r][x] = " "

    def render(self):
        return "\n".join("".join(row).rstrip() for row in self.g)


CSI_RE = re.compile(r"\x1b\[([0-9;:?]*)([@-~])")


def handle_csi(scr, params, final):
    if final in ("H", "f", "A", "B", "C", "D", "E", "F", "G"):
        scr.pending = False     # an explicit move cancels a pending wrap
    ps = [int(x) for x in params.split(";") if x.isdigit()]

    def p(i, default=0):
        return ps[i] if len(ps) > i else default

    if final in ("H", "f"):
        scr.r = min(max(p(0, 1) - 1, 0), scr.rows - 1)
        scr.c = min(max(p(1, 1) - 1, 0), scr.cols - 1)
    elif final == "J":
        if p(0) in (2, 3):
            scr.clear()
        elif p(0) == 0:
            scr.erase(scr.c, scr.cols)
            for y in range(scr.r + 1, scr.rows):
                for x in range(scr.cols):
                    scr.g[y][x] = " "
    elif final == "K":
        mode = p(0)
        if mode == 0:
            scr.erase(scr.c, scr.cols)
        elif mode == 1:
            scr.erase(0, scr.c + 1)
        else:
            scr.erase(0, scr.cols)
    elif final == "A":
        scr.r = max(0, scr.r - p(0, 1))
    elif final == "B":
        scr.r = min(scr.rows - 1, scr.r + p(0, 1))
    elif final == "C":
        scr.c = min(scr.cols - 1, scr.c + p(0, 1))
    elif final == "D":
        scr.c = max(0, scr.c - p(0, 1))
    elif final == "G":
        scr.c = min(scr.cols - 1, max(0, p(0, 1) - 1))


def feed(scr, data):
    """Replay a captured byte stream onto the screen."""
    i, n = 0, len(data)
    while i < n:
        ch = data[i]
        if ch != "\x1b":
            if ch == "\r":
                scr.pending = False
                scr.c = 0
            elif ch == "\n":
                scr.pending = False
                scr.r = min(scr.r + 1, scr.rows - 1)
            elif ch == "\b":
                scr.pending = False
                scr.c = max(0, scr.c - 1)
            elif ch != "\x07":
                scr.put(ch)
            i += 1
            continue
        if i + 1 < n and data[i + 1] == "[":
            m = CSI_RE.match(data, i)
            if not m:
                i += 1
                continue
            handle_csi(scr, m.group(1), m.group(2))
            i = m.end()
            continue
        if i + 1 < n and data[i + 1] == "]":       # OSC: skip to BEL or ST
            m = re.search(r"\x07|\x1b\\", data[i:])
            i += m.end() if m else (n - i)
            continue
        if i + 1 < n and data[i + 1] in ("(", ")"):  # charset select
            i += 3
            continue
        i += 2


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--bin", default="bin/heron")
    ap.add_argument("--seed")
    ap.add_argument("--demo", action="store_true", default=True)
    ap.add_argument("--live", action="store_true", help="use goose instead of -demo")
    ap.add_argument("--keys", default="")
    ap.add_argument("--out")
    ap.add_argument("--cols", type=int, default=100)
    ap.add_argument("--rows", type=int, default=30)
    ap.add_argument("--settle", type=float, default=1.0)
    ap.add_argument("--after", type=float, default=0.6)
    ap.add_argument("--raw", action="store_true")
    a = ap.parse_args()

    argv = [a.bin]
    if not a.live:
        argv.append("-demo")
    if a.seed:
        argv += ["-seed", a.seed]

    pid, fd = pty.fork()
    if pid == 0:
        # Force a colour-capable terminal: inheriting TERM (often "dumb" in a
        # non-interactive shell) makes lipgloss fall back to plain text, so the
        # screenshot would hide every colour the user actually sees.
        os.environ["TERM"] = "xterm-256color"
        os.environ["COLORTERM"] = "truecolor"
        os.environ.pop("NO_COLOR", None)
        os.environ["COLUMNS"] = str(a.cols)
        os.environ["LINES"] = str(a.rows)
        try:
            os.execvp(argv[0], argv)
        except Exception as e:
            sys.stderr.write(str(e))
            os._exit(127)

    fcntl.ioctl(fd, termios.TIOCSWINSZ,
                struct.pack("HHHH", a.rows, a.cols, 0, 0))

    buf = []
    try:
        drain(fd, a.settle, buf)
        if a.keys:
            os.write(fd, emit(a.keys))
            drain(fd, a.after, buf)
    finally:
        # Snapshot the frame as the user last saw it. On shutdown bubbletea
        # erases the cursor row (ESC[r;H ESC[2K), which would otherwise wipe
        # the prompt box's bottom border out of the replay.
        live = b"".join(buf)
        try:
            os.write(fd, b"\x03")          # Ctrl+C: clean quit
        except OSError:
            pass
        drain(fd, 0.5, buf)
        try:
            os.close(fd)
        except OSError:
            pass
        try:
            os.waitpid(pid, os.WNOHANG)
        except ChildProcessError:
            pass

    raw = b"".join(buf).decode("utf-8", "replace")

    if a.raw:
        text = raw
    else:
        # Replay the pre-shutdown stream into the emulator instead of
        # concatenating frames: that keeps borders, cursor moves and partial
        # repaints intact.
        scr = Screen(a.rows, a.cols)
        feed(scr, live.decode("utf-8", "replace"))
        text = scr.render()

    if a.out:
        with open(a.out, "w") as f:
            f.write(text + "\n")
        print(f"wrote {a.out} ({len(text)} bytes)")
    else:
        print(text)

if __name__ == "__main__":
    main()
